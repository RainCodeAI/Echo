{
  "name": "echo",
  "version": "0.1.0",
  "private": true,
  "description": "Voice-first field notes for contractors and trades businesses.",
  "scripts": {
    "dev": "next dev",
    "dev:convex": "convex dev",
    "dev:all": "npm-run-all --parallel dev dev:convex",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "typecheck:convex": "tsc -p convex/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "convex:typecheck": "convex typecheck",
    "codegen": "convex codegen --typecheck disable",
    "ci": "npm run typecheck && npm run typecheck:convex && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.9.6",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@sentry/nextjs": "^11.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.21.0",
    "lucide-react": "^0.469.0",
    "next": "^16.4.5",
    "openai": "^7.53.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.4.5",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
