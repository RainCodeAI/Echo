# =============================================================================
# Echo environment variables
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit real secrets.
# =============================================================================

# --- Convex -----------------------------------------------------------------
# Created automatically when you run `npx convex dev` for the first time.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# --- Clerk ------------------------------------------------------------------
# https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY

# The "Issuer" (Frontend API) URL from your Clerk JWT template named "convex".
# Clerk dashboard -> JWT Templates -> New template -> Convex.
# Looks like: https://your-app.clerk.accounts.dev
# Also set on Convex: npx convex env set CLERK_JWT_ISSUER_DOMAIN <issuer>
NEXT_PUBLIC_CLERK_FRONTEND_API_URL=https://your-app.clerk.accounts.dev

# Where Clerk should send users for auth.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- OpenAI (Convex deployment only for production) -------------------------
# Used server-side inside Convex actions. Set on the deployment:
#   npx convex env set OPENAI_API_KEY sk-...
#   npx convex env set OPENAI_MODEL gpt-4o-mini
#   npx convex env set OPENAI_TRANSCRIBE_MODEL whisper-1   (compare models with
#     scripts/eval-transcription.mjs before switching)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Field entry tokens (REQUIRED for secure field entry) -------------------
# HMAC secret that signs the short-lived field tokens issued after PIN verify.
# Without it, the app falls back to an INSECURE dev secret and logs a warning —
# field tokens would be forgeable. Set a real random value on the Convex
# deployment before production:
#   npx convex env set ENTRY_TOKEN_SECRET <random 32+ byte string>
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENTRY_TOKEN_SECRET=

# --- Urgent alerts (Convex deployment env, not .env.local) ------------------
# Each channel switches on when its keys are set; see docs/DEPLOY.md.
#   npx convex env set APP_URL https://echo.raincode.ai        (link in alerts)
#   npx convex env set ALERT_FROM_EMAIL "Echo Alerts <alerts@raincode.ai>"
#   npx convex env set RESEND_API_KEY                           (prompts)
#   npx convex env set TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM_NUMBER

# --- Error monitoring (optional; Sentry is inert without a DSN) --------------
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX
# Source map upload at build time (Vercel production only):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=raincode
# SENTRY_PROJECT=echo

# --- Deploy (Vercel only, not local) ----------------------------------------
# vercel.json runs `npx convex deploy --cmd 'npm run build'`, which needs a
# Convex deploy key and sets NEXT_PUBLIC_CONVEX_URL for the build itself.
# CONVEX_DEPLOY_KEY=prod:...
#
# After deploying, verify Convex config with:
#   npx convex run ops:checkConfig --prod
